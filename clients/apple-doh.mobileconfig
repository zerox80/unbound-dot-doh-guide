<?xml version="1.0" encoding="UTF-8"?>
<!--
  DNS-over-HTTPS fuer iPhone, iPad und Mac.
  Vor dem Installieren:
    1. dns.example.com durch den eigenen Hostnamen ersetzen
    2. Beide PayloadUUID-Werte durch neue UUIDs ersetzen (PowerShell: New-Guid, macOS/Linux: uuidgen)
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>PayloadContent</key>
  <array>
    <dict>
      <key>DNSSettings</key>
      <dict>
        <key>DNSProtocol</key>
        <string>HTTPS</string>
        <key>ServerURL</key>
        <string>https://dns.example.com/dns-query</string>
      </dict>
      <key>PayloadDisplayName</key>
      <string>Eigener DNS (DoH)</string>
      <key>PayloadIdentifier</key>
      <string>com.example.dns.doh.settings</string>
      <key>PayloadType</key>
      <string>com.apple.dnsSettings.managed</string>
      <key>PayloadUUID</key>
      <string>3F2A9C1E-0000-4000-8000-000000000001</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
    </dict>
  </array>
  <key>PayloadDescription</key>
  <string>Leitet alle DNS-Anfragen verschluesselt per DNS-over-HTTPS an den eigenen Resolver.</string>
  <key>PayloadDisplayName</key>
  <string>Eigener DNS (DoH)</string>
  <key>PayloadIdentifier</key>
  <string>com.example.dns.doh</string>
  <key>PayloadRemovalDisallowed</key>
  <false/>
  <key>PayloadType</key>
  <string>Configuration</string>
  <key>PayloadUUID</key>
  <string>3F2A9C1E-0000-4000-8000-000000000002</string>
  <key>PayloadVersion</key>
  <integer>1</integer>
</dict>
</plist>
